          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH piezas AS (\r\n  SELECT pieza\r\n  FROM logs.logs\r\n  WHERE $__timeFilter(fecha)\r\n    AND pieza IS NOT NULL\r\n    AND country IN ($country)\r\n    AND LOWER(usuario) = LOWER('${__user.login}')\r\n  GROUP BY pieza\r\n  ORDER BY COUNT(*) DESC\r\n  LIMIT 5\r\n),\r\ndatos_agrupados AS (\r\n  SELECT\r\n    $__timeGroup(l.fecha, '$interval') AS time,\r\n    l.pieza,\r\n    COUNT(*) as total_diario\r\n  FROM logs.logs l\r\n  JOIN piezas tp ON l.pieza = tp.pieza\r\n  WHERE $__timeFilter(l.fecha) AND country IN ($country)\r\n    AND LOWER(USUARIO) = LOWER('${__user.login}')\r\n  GROUP BY time, l.pieza\r\n)\r\nSELECT\r\n  time,\r\n  pieza,\r\n  total_diario,\r\n  SUM(total_diario) OVER (PARTITION BY pieza ORDER BY time) AS acumulado\r\nFROM datos_agrupados\r\nORDER BY pieza, time;",
