          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH catalogos AS (\r\n  SELECT catalogo\r\n  FROM logs.logs\r\n  WHERE $__timeFilter(fecha)\r\n    AND catalogo IS NOT NULL\r\n    AND country IN ($country)\r\n    AND LOWER(usuario) = LOWER('${__user.login}')\r\n  GROUP BY catalogo\r\n  ORDER BY COUNT(*) DESC\r\n  LIMIT 10\r\n)\r\n\r\nSELECT \r\n  $__timeGroup(fecha, $interval) AS time,\r\n  l.catalogo,\r\n  COUNT(*) AS Total\r\nFROM logs.logs l\r\nJOIN catalogos tc ON l.catalogo = tc.catalogo\r\nWHERE $__timeFilter(fecha)\r\n  AND country IN ($country)\r\n  AND LOWER(usuario) = LOWER('${__user.login}')\r\nGROUP BY time, l.catalogo\r\nORDER BY time, Total DESC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
